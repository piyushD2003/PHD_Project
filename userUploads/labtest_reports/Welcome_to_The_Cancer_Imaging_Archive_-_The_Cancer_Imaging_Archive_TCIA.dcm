.fetched_tweets li { word-break: break-word; hyphens: auto; }

.tweets_avatar { margin-bottom: 15px; }

.tweets_avatar img { float: left; margin-right: 10px; border-radius: 5px; }

.circular { border-radius: 50% !important; }

.tweets-intent-data { width: 200px; margin-top: 5px; float: right; }

.tweets-intent-data a { margin-right: 5px; }

[data-icon]::before { content: attr(data-icon); speak: none; font-weight: n=
ormal; font-variant: normal; font-size: 20px; text-transform: none; line-he=
ight: 1; -webkit-font-smoothing: antialiased; font-family: stt-intents !imp=
ortant; }

.pi-visuallyhidden { border: 0px; clip: rect(0px, 0px, 0px, 0px); height: 1=
px; margin: -1px; overflow: hidden; padding: 0px; position: absolute; width=
: 1px; }

div.wdtf-user-card { width: 100%; margin-bottom: 5px; float: left; }

.fetched_tweets > li { font-family: "Helvetica Neue", Helvetica, Arial, san=
s-serif; box-shadow: rgba(0, 0, 0, 0.15) 0px 1px 3px; }

.tweet_data { float: left; font: 16px / 20px Georgia, "Times New Roman", Pa=
latino, serif; }

.fetched_tweets .tweets_avatar .tweet_data a { text-decoration: none; }

.light .tweets-intent-data { width: 100%; border-top: 1px solid rgb(232, 23=
2, 232); }

.dark .tweets-intent-data { width: 100%; border-top: 1px solid rgb(68, 68, =
68); }

.tweets-intent-data a { text-decoration: none; }

.tweets-intent-data li { display: inline-block; float: none; text-align: ce=
nter; width: 31.33% !important; }

.tweets-intent-data ul { margin-bottom: 7px; padding-top: 7px; display: blo=
ck; margin-left: 0px; margin-top: 0px; }

.seperator_wpltf { clear: left; border-top: 1px solid rgb(232, 232, 232); m=
argin: 3px auto; }

.light .seperator_wpltf { border-top: 1px solid rgb(232, 232, 232); }

.dark .seperator_wpltf { border-top: 1px solid rgb(68, 68, 68); }

.fetched_tweets .tweets_avatar .tweet_data a:hover { text-decoration: under=
line; }

div.wdtf-screen-name { margin-left: 4px; float: left; font-size: 1.1em; wid=
th: 68%; line-height: 18px; }

.wp_image { background: rgb(204, 204, 204); }

.clear { clear: both; }

.fetched_tweets { border: medium none; list-style: outside none none; outli=
ne: none medium; padding: 0px; position: relative; width: 100%; margin: 0px=
 !important; }

ul.light li.tweets_avatar .times a, ul.light li.tweets_avatar .wdtf-screen-=
name a, ul.light li.tweets_avatar .stats a { text-decoration: none; width: =
100%; color: rgb(153, 153, 153) !important; }

ul.dark li.tweets_avatar .times a, ul.dark li.tweets_avatar .wdtf-screen-na=
me a, ul.dark li.tweets_avatar .stats a { text-decoration: none; width: 100=
%; color: rgb(160, 160, 160) !important; }

.times a:hover, .wdtf-screen-name a:hover, .stats a:hover { text-decoration=
: underline; }

.stats-favorites { text-transform: uppercase; font-size: 11px; }

span.stats-narrow .stats { display: block; }

span.stats-narrow .stats a { display: block; width: 45%; float: left; }

li.tweets_avatar { border-radius: 5px; padding: 8px 8px 0px !important; }

.light div.wdtf-screen-name span.screen_name { font-weight: bold; color: rg=
b(0, 0, 0) !important; }

.dark div.wdtf-screen-name span.screen_name { font-weight: bold; color: rgb=
(207, 207, 207) !important; }

div.times { float: left; }

.isa_info, .isa_success, .isa_warning, .isa_error { border: 1px solid; marg=
in: 10px 0px; padding: 15px 10px; background-repeat: no-repeat; background-=
position: 10px center; border-radius: 0.5em; }

.isa_info { color: rgb(0, 82, 155); background-color: rgb(189, 229, 248); }

.isa_success { color: rgb(79, 138, 16); background-color: rgb(223, 242, 191=
); }

.isa_warning { color: rgb(159, 96, 0); background-color: rgb(254, 239, 179)=
; }

.isa_error { color: rgb(216, 0, 12); background-color: rgb(255, 186, 186); =
}

ul.light li.tweets_avatar { background: rgb(255, 255, 255); color: rgb(0, 0=
, 0) !important; }

ul.dark li.tweets_avatar { background: rgb(51, 51, 51); color: rgb(255, 255=
, 255) !important; }

.fetched_tweets.light .tweets_avatar .tweet_data a { color: rgb(0, 132, 180=
) !important; }

.fetched_tweets.dark .tweets_avatar .tweet_data a { color: rgb(135, 194, 23=
7) !important; }

ul.dark li.tweets_avatar .tweet_data { color: rgb(255, 255, 255) !important=
; }

ul.light li.tweets_avatar .tweet_data { color: rgb(0, 0, 0) !important; }

