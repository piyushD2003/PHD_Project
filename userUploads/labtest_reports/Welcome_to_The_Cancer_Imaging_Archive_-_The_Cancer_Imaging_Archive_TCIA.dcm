.wpb_animate_when_almost_visible { opacity: 0; }

.wpb_animate_when_almost_visible:not(.wpb_start_animation) { animation: aut=
o ease 0s 1 normal none running none; }

.top-to-bottom, .wpb_top-to-bottom { animation: 0.7s cubic-bezier(0.175, 0.=
885, 0.32, 1.275) 0s 1 normal none running wpb_ttb; }

.bottom-to-top, .wpb_bottom-to-top { animation: 0.7s cubic-bezier(0.175, 0.=
885, 0.32, 1.275) 0s 1 normal none running wpb_btt; }

.left-to-right, .wpb_left-to-right { animation: 0.7s cubic-bezier(0.175, 0.=
885, 0.32, 1.275) 0s 1 normal none running wpb_ltr; }

.right-to-left, .wpb_right-to-left { animation: 0.7s cubic-bezier(0.175, 0.=
885, 0.32, 1.275) 0s 1 normal none running wpb_rtl; }

.appear, .wpb_appear { animation: 0.7s cubic-bezier(0.175, 0.885, 0.32, 1.2=
75) 0s 1 normal none running wpb_appear; transform: scale(1); }

.wpb_start_animation { opacity: 1; }

@-webkit-keyframes wpb_ttb {=20
  0% { transform: translate(0px, -10%); opacity: 0; }
  100% { transform: translate(0px, 0px); opacity: 1; }
}

@keyframes wpb_ttb {=20
  0% { transform: translate(0px, -10%); opacity: 0; }
  100% { transform: translate(0px, 0px); opacity: 1; }
}

@-webkit-keyframes wpb_btt {=20
  0% { transform: translate(0px, 10%); opacity: 0; }
  100% { transform: translate(0px, 0px); opacity: 1; }
}

@keyframes wpb_btt {=20
  0% { transform: translate(0px, 10%); opacity: 0; }
  100% { transform: translate(0px, 0px); opacity: 1; }
}

@-webkit-keyframes wpb_ltr {=20
  0% { transform: translate(-10%, 0px); opacity: 0; }
  100% { transform: translate(0px, 0px); opacity: 1; }
}

@keyframes wpb_ltr {=20
  0% { transform: translate(-10%, 0px); opacity: 0; }
  100% { transform: translate(0px, 0px); opacity: 1; }
}

@-webkit-keyframes wpb_rtl {=20
  0% { transform: translate(10%, 0px); opacity: 0; }
  100% { transform: translate(0px, 0px); opacity: 1; }
}

@keyframes wpb_rtl {=20
  0% { transform: translate(10%, 0px); opacity: 0; }
  100% { transform: translate(0px, 0px); opacity: 1; }
}

@-webkit-keyframes wpb_appear {=20
  0% { transform: scale(0.5); opacity: 0.1; }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes wpb_appear {=20
  0% { transform: scale(0.5); opacity: 0.1; }
  100% { transform: scale(1); opacity: 1; }
}

