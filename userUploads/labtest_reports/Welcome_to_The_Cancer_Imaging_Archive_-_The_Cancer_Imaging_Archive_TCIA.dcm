.wpstg--green { color: rgb(59, 186, 104); }

.wpstg--grey { color: rgb(57, 57, 57); }

.wpstg--darkgrey { color: rgb(27, 27, 27); }

.wpstg--filter--svg { filter: invert(24%) sepia(11%) saturate(558%) hue-rot=
ate(169deg) brightness(97%) contrast(91%); }

.wpstg-require-free { background-color: rgb(224, 30, 90); border: 1px solid=
 rgb(255, 255, 255); color: rgb(255, 255, 255); font-weight: 500; position:=
 relative; }

.wpstg-require-free a { color: rgb(255, 255, 255); }

#wpstg-activate-free { align-items: center; background-color: rgb(26, 115, =
232); color: rgb(255, 255, 255); display: inline-flex; margin-left: 10px; }

#wpstg-plugin-activation-loader { content: url("//www.cancerimagingarchive.=
net/wp-content/plugins/wp-staging-pro/assets/img/wpstg-loader.gif"); displa=
y: none; height: 25px; margin-left: 10px; }
